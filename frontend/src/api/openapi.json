  "components": {
    "schemas": {
      "ChannelInput": {
        "properties": {
          "file": {
            "type": "string",
            "title": "File"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "step",
                  "linear",
                  "average"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "file",
          "channel"
        ],
        "title": "ChannelInput"
      },
      "ChannelOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "samples": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Samples"
          },
          "t_min_us": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "T Min Us"
          },
          "t_max_us": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "T Max Us"
          },
          "period_us": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period Us"
          },
          "native_hz": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Native Hz"
          },
          "assigned_hz": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned Hz"
          },
          "n": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "N"
          },
          "event": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event"
          },
          "v_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "V Min"
          },
          "v_max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "V Max"
          },
          "suggested_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Mode"
          },
          "modes_allowed": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modes Allowed"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ChannelOut"
      },
      "ChannelRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "step",
                  "linear",
                  "average"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode",
            "description": "Default: step for event channels, linear otherwise"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ChannelRequest"
      },
      "ChannelsOut": {
        "properties": {
          "complete": {
            "type": "boolean",
            "title": "Complete"
          },
          "channels": {
            "items": {
              "$ref": "#/components/schemas/ChannelOut"
            },
            "type": "array",
            "title": "Channels"
          }
        },
        "type": "object",
        "required": [
          "complete",
          "channels"
        ],
        "title": "ChannelsOut"
      },
      "ChunkOut": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "received": {
            "type": "integer",
            "title": "Received"
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          }
        },
        "type": "object",
        "required": [
          "index",
          "received",
          "total_chunks"
        ],
        "title": "ChunkOut"
      },
      "CsvOptions": {
        "properties": {
          "decimal": {
            "type": "string",
            "enum": [
              ".",
              ","
            ],
            "title": "Decimal",
            "default": "."
          },
          "delimiter": {
            "type": "string",
            "enum": [
              ",",
              ";",
              "\t"
            ],
            "title": "Delimiter",
            "default": ","
          }
        },
        "type": "object",
        "title": "CsvOptions"
      },
      "ExportRequest": {
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "parquet"
            ],
            "title": "Format"
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/ExportSeries"
            },
            "type": "array",
            "minItems": 1,
            "title": "Series"
          },
          "k_from": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "K From",
            "description": "First lattice step of the window (inclusive); null = from the start"
          },
          "k_to": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "K To",
            "description": "Last lattice step (inclusive); null = to the end"
          },
          "shifts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Shifts",
            "default": {}
          },
          "csv": {
            "$ref": "#/components/schemas/CsvOptions",
            "default": {
              "decimal": ".",
              "delimiter": ","
            }
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "default": "viewer-export"
          }
        },
        "type": "object",
        "required": [
          "format",
          "series"
        ],
        "title": "ExportRequest"
      },
      "ExportSeries": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Value of the channel column, e.g. 'A: f10_000' or '\u0192 Smooth difference'"
          },
          "file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "channel": {
            "type": "string",
            "title": "Channel",
            "default": ""
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "step",
                  "linear",
                  "average"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "handle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handle",
            "description": "Result of an operator (calculated channel) instead of file/channel"
          }
        },
        "type": "object",
        "required": [
          "label"
        ],
        "title": "ExportSeries"
      },
      "FileOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Bytes"
          },
          "vin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vin"
          },
          "configuration_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
